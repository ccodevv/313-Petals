# Copy this file to .env.local and fill in your Supabase project's values.
# Find these under Project Settings -> API in the Supabase dashboard.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Never expose the service-role key to the client or commit it. It is not
# used by this app - all authorization is enforced through RLS using the
# signed-in user's own JWT.
