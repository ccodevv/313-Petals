# Copy this file to .env.local and fill in your Supabase project's values.
# Find these under Project Settings -> API in the Supabase dashboard.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The base URL of this app. Used to build redirect/callback URLs (password
# reset links, Stripe success/cancel URLs). Update it to your real domain
# in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Used in exactly one place: the Stripe webhook route handler
# (src/app/api/webhooks/stripe/route.ts), to mark an order paid once Stripe
# confirms payment - that request comes from Stripe, not a signed-in user,
# so there's no user JWT for RLS to check against. Never import this key
# anywhere else, never prefix it with NEXT_PUBLIC_, and never expose it to
# the client - it bypasses Row Level Security entirely.
# Find it under Project Settings -> API Keys -> Secret keys.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (test mode keys start with sk_test_ / whsec_ from the Stripe CLI
# or your webhook endpoint's signing secret). See README.md for full setup.
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
